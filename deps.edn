{:paths ["src"]
 :version "0.1.0"
 ;; kotoba-lang/process — foundational process spawn: pure policy + host-injected
 ;; transport. Twin of kotoba-lang/fs. Zero third-party runtime deps; .cljc.
 ;; Catalog name :process/spawn (wire id 20). Does NOT grant ambient PATH.
 :deps {
        io.github.kotoba-lang/process-process
        {:git/url "https://github.com/kotoba-lang/process-process.git"
         :git/sha "2f4011cf7407cfce84b733596fee67dd30e82d16"}
        io.github.kotoba-lang/process-echo-process
        {:git/url "https://github.com/kotoba-lang/process-echo-process.git"
         :git/sha "c40338339bb308cb613cd63f7e81df9ed5341390"}
        io.github.kotoba-lang/process-exec
        {:git/url "https://github.com/kotoba-lang/process-exec.git"
         :git/sha "31c4ac74e8bffeb1cbe3479d1f83fca0e2da5da8"}
        io.github.kotoba-lang/process-validate-spawn
        {:git/url "https://github.com/kotoba-lang/process-validate-spawn.git"
         :git/sha "b4d98a83cdeefd8495f56544bef2280112beb47d"}


        ;; kotoba stdlib, not clojure.*. Pinned as explicit floors: tools.deps
        ;; takes the NEWEST sha it is shown, so without a floor here this repo
        ;; silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       }
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
